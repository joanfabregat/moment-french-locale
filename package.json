{
  "name": "moment-french-locale",
  "version": "1.3.2",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/moment-french-locale.js",
  "module": "dist/moment-french-locale.mjs",
  "types": "dist/moment-french-locale.d.ts",
  "source": "src/moment-french-locale.ts",
  "exports": {
    "types": "./dist/moment-french-locale.d.ts",
    "import": "./dist/moment-french-locale.mjs",
    "require": "./dist/moment-french-locale.js"
  },
  "description": "Provides moment.js with French locale",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joanfabregat/moment-french-locale.git"
  },
  "dependencies": {
    "moment": "^2"
  },
  "author": {
    "name": "Joan Fabrégat",
    "email": "joan@codeinc.co"
  },
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "esbuild src/moment-french-locale.ts --format=cjs --platform=node --target=es2020 --outfile=dist/moment-french-locale.js --sourcemap && esbuild src/moment-french-locale.ts --format=esm --platform=node --target=es2020 --outfile=dist/moment-french-locale.mjs --sourcemap",
    "build:types": "tsc --emitDeclarationOnly --declaration",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2"
  }
}
