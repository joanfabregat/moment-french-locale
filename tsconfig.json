{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "rootDir": "src",
    "sourceMap": true,
    "target": "es2020",
    "outDir": "dist"
  },
  "include": [
    "src/**/*"
  ]
}
